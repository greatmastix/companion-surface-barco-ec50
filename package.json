{
	"name": "companion-surface-barco-ec50",
	"version": "0.0.1",
	"description": "Bitfocus Companion surface module for the Barco EC-50 keyboard",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"postinstall": "node scripts/koffi-prebuilds.mjs",
		"build": "tsc -p tsconfig.build.json",
		"test": "tsx src/keymap.test.ts && tsx src/mpsse.test.ts && tsx src/showboard.test.ts && tsx src/settings.test.ts",
		"check": "companion-surface-check",
		"package": "companion-surface-build",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-surface-barco-ec50.git"
	},
	"engines": {
		"node": "^22.12",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-surface/base": "~1.3.0",
		"koffi": "2.9.0",
		"usb": "^2.19.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^22.0.0",
		"eslint": "^10.2.0",
		"prettier": "^3",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.12.0"
}
